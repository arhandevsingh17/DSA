#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N, K;
        cin >> N >> K;

        vector<int> A(N);
        int S = 0;

        for (int i = 0; i < N; i++) {
            cin >> A[i];
            S += A[i];
        }

        int ans = 0;
        int need = 2 * K - S;

        for (int i = 0; i < N; i++) {
            for (int j = i + 1; j < N; j++) {
                if (A[i] + A[j] > need)
                    ans++;
            }
        }

        cout << ans << "\n";
    }
}
