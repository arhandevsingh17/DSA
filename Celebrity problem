#include <iostream>
#include <vector>
#include <stack>
using namespace std;

int celebrity(vector<vector<int>>& M, int n) {

    stack<int> st;

    for (int i = 0; i < n; i++) {
        st.push(i);
    }

    while (st.size() > 1) {

        int a = st.top();
        st.pop();

        int b = st.top();
        st.pop();

        if (M[a][b] == 1)
            st.push(b);
        else
            st.push(a);
    }

    int candidate = st.top();

    for (int i = 0; i < n; i++) {

        if (i != candidate &&
            (M[candidate][i] == 1 || M[i][candidate] == 0))
            return -1;
    }

    return candidate;
}

int main() {

    vector<vector<int>> M = {
        {0,1,1},
        {0,0,1},
        {0,0,0}
    };

    cout << celebrity(M, 3);
}
