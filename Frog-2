#include<bits/stdc++.h>
using namespace std;

int main(){
ios_base::sync_with_stdio(0);
cin.tie(0);
int n,k;
cin>>n>>k;
vector<int>h(n);
for(int &x:h)cin>>x;
vector<int>dp(n,1e9);
dp[0]=0;
for(int i=0;i<n;i++){
for(int j=1;j<=k;j++){
if(i>=j)dp[i]=min(dp[i],dp[i-j]+abs(h[i-j]-h[i]));
}}
cout<<dp[n-1]<<"\n";
return 0;
}
